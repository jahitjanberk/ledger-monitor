# Cache rules for Netlify and Cloudflare Pages (other hosts ignore this file).
# Files whose names carry a content hash, and the fonts, never change in place,
# so browsers may keep them for a year. Everything else is checked on each visit.
# index-CzSELinI.css is left out: it was edited after the build, so its name no longer matches its content.

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/maplibre-ChAaPfnC.js
  Cache-Control: public, max-age=31536000, immutable

/assets/d3-CYFjbSD-.js
  Cache-Control: public, max-age=31536000, immutable

/assets/story-Cpe0Yf6I.js
  Cache-Control: public, max-age=31536000, immutable

/assets/charts-B-YMMjus.css
  Cache-Control: public, max-age=31536000, immutable

/assets/og/*
  Cache-Control: public, max-age=86400

/assets/icons/*
  Cache-Control: public, max-age=86400

# Security headers. GitHub Pages ignores this file, so each page also carries the same
# Content-Security-Policy in a <meta> tag. The sha256 values allow the two inline scripts
# (theme and load check); if you edit either script, update its hash here and in every page,
# or the browser will block it (node scripts/check.mjs reports the blocked script).
# Framing is blocked everywhere except embed/, the page made to sit in other sites' iframes.
# Neither Netlify nor Cloudflare Pages can remove a header that /* sets, so the framing rules
# below are listed per folder instead. Where two rules both set Content-Security-Policy the
# hosts join them with a comma, which browsers treat as two policies that must both pass.
# frame-ancestors only works as a header, not in the <meta> tag.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-XnOHSLEiieKuPeLJBWy7Z1nqz7V8xHfDZNIJhjGciNw=' 'sha256-50w1Whx3irPo1Xx2ESNouowIhiFbG+BpPd6KI+ZRu2g='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# No framing, except for embed/ (see above).
/
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

